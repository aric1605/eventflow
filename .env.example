# EventFlow Environment Configuration
# Database: Neon PostgreSQL (pooled connection string, sslmode=require, without channel_binding)
DATABASE_URL=postgresql://user:password@ep-xyz-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# Transport: Upstash Redis (TCP rediss:// connection string, not REST)
REDIS_URL=rediss://default:token@holy-quetzal-146048.upstash.io:6379

# Security
API_KEY=ef_dev_secret_key_change_in_production

# Server & Runtime
PORT=10000
ROLE=all
DEMO_MODE=true
LOG_LEVEL=info

# Worker Engine Tuning
WORKER_CONCURRENCY=5
MAX_ATTEMPTS=4
RETRY_BASE_MS=2000
RETRY_MAX_MS=60000
VISIBILITY_TIMEOUT_MS=30000
HANDLER_TIMEOUT_MS=8000
IDLE_POLL_MAX_MS=60000
SWEEP_INTERVAL_MS=30000

# Redis Stream Limits
STREAM_MAXLEN=10000
DLQ_MAXLEN=1000
